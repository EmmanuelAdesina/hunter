# hunter - credential file template.
#
# Copy to /etc/hunter/hunter.env, fill in the values, then:
#
#   chown hunter:hunter /etc/hunter/hunter.env
#   chmod 0600 /etc/hunter/hunter.env
#
# The permissions are the security boundary, not a convention. systemd reads
# this file as root before dropping to the service account, and the service
# account must be able to read it and nothing else should. A world-readable
# environment file on a production host discloses the mail credential to every
# local account and to any process that can read /proc.
#
# Every value is a plain assignment. Do not add quotes unless a value contains a
# space, do not add `export`, and do not add any key the binary does not read:
# an unread key here is a credential sitting on disk for nothing.

# Mail provider hostname, for example smtp.gmail.com or smtp.protonmail.com.
EMAIL_SMTP_HOST=

# Mail provider port. 587 is correct for submission with STARTTLS, which is what
# the client negotiates. Use 465 only if your provider requires implicit TLS,
# which this client does not use.
EMAIL_SMTP_PORT=

# Mail account used both to authenticate and as the From address.
EMAIL_USERNAME=

# Mail account password or app token.
#
# Use an app-specific token rather than the account password. It can be revoked
# on its own, it is scoped to this one use, and it never travels to a website
# login form.
EMAIL_PASSWORD=

# Where alerts are delivered. Comma-separated for more than one recipient.
ALERT_RECIPIENT=

# Optional display name for the From header, for example "hunter".
# Leave blank to send with the bare account address.
EMAIL_FROM_NAME=